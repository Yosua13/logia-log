# ==============================================================================
# SENTINEL-AI v3.1 (TARGET-AGNOSTIC EDITION) - FRONTEND ENVIRONMENT CONFIGURATION
# File: frontend/.env (atau frontend/.env.local)
# ==============================================================================

# API Base URL:
# - Mode Dev (Vite Proxy ke localhost:8080): gunakan /api/v1
# - Mode Direct / Production: gunakan http://localhost:8080/api/v1 (atau URL backend Anda)
VITE_API_BASE_URL=/api/v1

# Judul Aplikasi
VITE_APP_TITLE="SentinelAI v3.1 • Target-Agnostic Observability & API Studio"

# Server-Sent Events (SSE) Stream Endpoint
VITE_SSE_LOG_STREAM_PATH=/api/v1/logs/stream
