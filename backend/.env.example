# ==============================================================================
# SENTINEL-AI v3.1 (TARGET-AGNOSTIC EDITION) - BACKEND ENVIRONMENT CONFIGURATION
# File: backend/.env
# ==============================================================================

# --- 1. Server & Profile ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_ORIGIN=http://localhost:5173

# --- 2. PostgreSQL 18.4 (Local psql 18.4 atau Docker postgres:18.4-alpine) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret

# --- 3. RabbitMQ 4.x Message Broker ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=sentinel_secret
RABBITMQ_VHOST=/
SENTINEL_RABBIT_CONSUMER_ENABLED=false

# --- 4. Redis SaaS: Upstash Serverless Redis (Free Tier - Recommended) ---
# Daftar gratis di https://console.upstash.com/ (Region: AWS ap-southeast-1 Singapore)
# Salin koneksi TLS (rediss://) di bawah ini (catatan: hostname Upstash menggunakan tanda hubung '-', bukan '_'):
UPSTASH_REDIS_URL=rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379
REDIS_SSL_ENABLED=true
SENTINEL_REDIS_DEDUP_ENABLED=false

# --- 5. Security & Encryption (AES-256-GCM 32-byte Base64 Key) ---
SENTINEL_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- 6. Deep GitHub & AI 7-Layer Diagnostic Engine (Opsional / Dynamic Plug-and-Play) ---
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_TOKEN=
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-pro
